{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "codus",
  "version": "0.1.0",
  "identifier": "com.codus.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "codus",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "createUpdaterArtifacts": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3ODVCRTUxNTA4RDY3OTIKUldTU1o0MVFVYjZGbDRMeHZqNUpaY2c3N1Q5bWZPZGtLb2xJUXZqd0tlTElJdWMzUDUzQ0g1SzEK%",
      "endpoints": ["https://github.com/JamieLivingstone/codus/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
